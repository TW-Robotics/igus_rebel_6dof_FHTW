<?xml version="1.0"?>
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="igus_rebel">

  <!-- ARGUMENTE: MUSS VOR INCLUDES -->
  <xacro:arg name="hardware_protocol" default="rebel"/>

  <!-- BASIS ROBOTER -->
  <xacro:include filename="$(find igus_rebel_description_real)/urdf/igus_complete.urdf.xacro" />
  <xacro:include filename="$(find igus_rebel_description_real)/urdf/igus_control.xacro"/>
  <xacro:igus_rebel_control arm_id="rebel_arm" hardware_protocol="$(arg hardware_protocol)"/>


  <!-- WORLD -->
  <link name="world" />

  <joint name="world_joint" type="fixed">
    <parent link="world" />
    <child link="base_plate" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

</robot>
