<?xml version="1.0"?>
<robot name="igus_complete" xmlns:xacro="http://wiki.ros.org/xacro" >

<!-- === Include section === -->
  <xacro:include filename="$(find igus_rebel_description_real)/urdf/igus_rebel.urdf" />
  <xacro:include filename="$(find igus_rebel_description_real)/urdf/endeffector.urdf"/>
  <!--xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro"/ Realsense Here-->
  
<!-- ===  Links === -->
  <link name="base_plate">
    <visual>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 2.0 0.1"/>
      </geometry>
      <material name="grey">
        <color rgba="0.6 0.6 0.6 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 -0.05" rpy="0 0 0"/>
      <geometry>
        <box size="2.0 2.0 0.1"/>
      </geometry>
    </collision>
  </link>
  
  <link name="tool0"/>
  
  <!-- Include D435 + args -->
  <xacro:arg name="use_nominal_extrinsics" default="true"/>
  <xacro:arg name="add_plug" default="true" />
  <xacro:arg name="use_mesh" default="true" />
  <xacro:include filename="$(find realsense2_description)/urdf/_d435.urdf.xacro" />
  
   <link name="d435_base_link" />
  <xacro:sensor_d435 parent="d435_base_link" use_nominal_extrinsics="$(arg use_nominal_extrinsics)" add_plug="$(arg add_plug)" use_mesh="$(arg use_mesh)">
    <origin xyz="0 0 0" rpy="0 -1.57079632679 -1.57079632679"/>
  </xacro:sensor_d435> 
  
  <!-- Schunk gripper, ~14 cm long. Link origin is the middle of the gripper (7 cm above the plate). -->
  <xacro:property name="jaw_stroke" value="0.006"/>  <!-- travel per jaw, open - closed [m] -->
  <xacro:property name="jaw_closed_x" value="0.008"/> <!-- jaw centre offset when closed [m] -->

  <material name="schunk_alu"><color rgba="0.75 0.75 0.78 1.0"/></material>
  <material name="schunk_black"><color rgba="0.1 0.1 0.1 1.0"/></material>

  <link name="schunk">
    <!-- black adapter plate on the flange -->
    <visual>
      <origin xyz="0 0 -0.0625" rpy="0 0 0"/>
      <geometry><box size="0.075 0.04 0.015"/></geometry>
      <material name="schunk_black"/>
    </visual>
    <!-- aluminium body -->
    <visual>
      <origin xyz="0 0 0.0" rpy="0 0 0"/>
      <geometry><box size="0.07 0.035 0.11"/></geometry>
      <material name="schunk_alu"/>
    </visual>
    <!-- black jaw guide at the front -->
    <visual>
      <origin xyz="0 0 0.0525" rpy="0 0 0"/>
      <geometry><box size="0.07 0.035 0.005"/></geometry>
      <material name="schunk_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 -0.005" rpy="0 0 0"/>
      <geometry><box size="0.075 0.04 0.13"/></geometry>
    </collision>
  </link>

  <xacro:macro name="schunk_jaw" params="side sign">
    <link name="schunk_jaw_${side}">
      <visual>
        <geometry><box size="0.012 0.03 0.02"/></geometry>
        <material name="schunk_black"/>
      </visual>
      <collision>
        <geometry><box size="0.012 0.03 0.02"/></geometry>
      </collision>
    </link>
    <joint name="schunk_jaw_${side}_joint" type="prismatic">
      <parent link="schunk"/>
      <child link="schunk_jaw_${side}"/>
      <origin xyz="${sign*jaw_closed_x} 0 0.065" rpy="0 0 0"/>
      <axis xyz="${sign} 0 0"/>
      <limit lower="0.0" upper="${jaw_stroke}" effort="100" velocity="0.1"/>
      <xacro:if value="${side == 'right'}">
        <mimic joint="schunk_jaw_left_joint" multiplier="1" offset="0"/>
      </xacro:if>
    </joint>
  </xacro:macro>
  <xacro:schunk_jaw side="left" sign="1"/>
  <xacro:schunk_jaw side="right" sign="-1"/>

  <!-- Tool centre point between the jaws -->
  <link name="TCPGripper"/>
  <joint name="fixed_to_TCP" type="fixed">
    <origin xyz="0 0 0.065" rpy="0 0 3.1415"/>
    <parent link="schunk"/>
    <child link="TCPGripper"/>
  </joint>

  <joint name="fixed_to_gripper" type="fixed">
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
    <parent link="endeffector_plate"/>
    <child link="schunk"/>
  </joint>

<!-- === Joints === -->
  
  <joint name="fixed_to_base_plate" type="fixed" >
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_plate" />
    <child link="base_link"/>
  </joint>
  
  <joint name="fixed_to_tool0" type="fixed" >
    <origin xyz="0 0 0.0522" rpy="0 0 0" />
    <parent link="link6" />
    <child link="tool0"/>
  </joint>
  
  <joint name="fixed_to_endeffector_plate" type="fixed" >
    <origin xyz="0 0 0" rpy="0 0 -0.5236" />
    <parent link="tool0" />
    <child link="endeffector_plate"/>
  </joint> 
  
  <!-- Fixed Joint for fixture to d435 camera -1.57079632679 -->
  <joint name="fixed_to_realsense" type="fixed">
    <origin xyz="-0.0325 0.05655 0.01905" rpy="0 0 0 "/>
    <parent link="endeffector_plate"/>
    <child link="d435_base_link"/>
  </joint>
  

  
  
  


</robot>
