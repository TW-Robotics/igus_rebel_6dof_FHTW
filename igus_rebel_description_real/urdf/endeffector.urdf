<?xml version="1.0"?>
<robot name="endeffector" xmlns:xacro="http://wiki.ros.org/xacro" >
    
    <link name="endeffector_plate">
      <visual>
        <geometry>
          <mesh filename="package://igus_rebel_description_real/meshes/endeff/basePlate.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </visual>
      <collision>
        <geometry>
          <mesh filename="package://igus_rebel_description_real/meshes/endeff/basePlate.stl" scale="0.001 0.001 0.001"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.1"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </inertial>
    </link>


</robot>
