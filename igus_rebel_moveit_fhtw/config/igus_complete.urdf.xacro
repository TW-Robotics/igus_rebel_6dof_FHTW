<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="igus_complete">
    <xacro:arg name="initial_positions_file" default="initial_positions.yaml" />

    <!-- Import igus_complete urdf file -->
    <xacro:include filename="$(find igus_rebel_description_real)/urdf/igus_complete.urdf.xacro" />

    <!-- Import control_xacro -->
    <xacro:include filename="igus_complete.ros2_control.xacro" />


    <xacro:igus_complete_ros2_control name="FakeSystem" initial_positions_file="$(arg initial_positions_file)"/>

</robot>
